#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Unix Script
# ----------------------------------------------------------------------------
set -e

basedir=$(dirname "$0")
mvnHome="$HOME/.m2/wrapper/dists/apache-maven-3.9.9"

if [ ! -d "$mvnHome" ]; then
    echo "Downloading Apache Maven 3.9.9..."
    mkdir -p "$mvnHome"
    curl -sSLo /tmp/maven.zip https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.9/apache-maven-3.9.9-bin.zip
    unzip -q /tmp/maven.zip -d "$HOME/.m2/wrapper/dists"
    rm /tmp/maven.zip
fi

exec "$HOME/.m2/wrapper/dists/apache-maven-3.9.9/bin/mvn" "$@"
